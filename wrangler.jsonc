{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "testi-tornado-app",
	"compatibility_date": "2025-04-04",
	"compatibility_flags": [
        "nodejs_compat"
    ],
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "db-testi",
			"database_id": "fe13ab0e-ce69-4e2f-98b7-c80e208bd4fa",
		}
	]
}